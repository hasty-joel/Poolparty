# Admin Authentication (Required - server fails closed if unset; no default fallback)
ADMIN_PASSCODE=

# Relworx Payment Gateway (Uganda Mobile Money - MTN & Airtel)
# Official Docs: https://payments.relworx.com/docs
RELWORX_API_KEY=
RELWORX_ACCOUNT_NO=
RELWORX_WEBHOOK_SECRET=
RELWORX_WEBHOOK_URL=

# Supabase (Server-side service role key - NEVER expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Client-side (Public anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Node Environment ('production' strictly disables sandbox simulations)
NODE_ENV=production