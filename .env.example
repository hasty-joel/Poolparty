# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL where the app is hosted (used for Flutterwave redirects & QR verification)
APP_URL="https://your-domain.vercel.app"

# ============================================================
# SUPABASE DATABASE & AUTH (Project: Poolparty)
# Found in Supabase Dashboard > Project Settings > API
# ============================================================
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SERVER-SIDE ONLY (Never exposed in frontend / client code)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ============================================================
# FLUTTERWAVE UGANDA MOBILE MONEY (MTN & AIRTEL MONEY IN UGX)
# Found in Flutterwave Dashboard > Settings > API Keys
# ============================================================
# Public key for optional frontend client verification
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X"

# Secret key used strictly on the server to initiate & verify payments
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X"

# Secret hash set in Flutterwave Dashboard > Settings > Webhooks to verify incoming webhooks
FLUTTERWAVE_WEBHOOK_HASH="your_secure_webhook_secret_hash"
